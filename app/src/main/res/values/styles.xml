<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="RoundedImage24">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="CircleImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="CardTitle">
        <item name="android:fontFamily">@font/gilroy_medium_0</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SectionTitle">
        <item name="android:fontFamily">@font/buyan_bold</item>
        <item name="android:textColor">#A8D93F</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="SectionAll">
        <item name="android:fontFamily">@font/gropled</item>
        <item name="android:textColor">#8A93A0</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Chip">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:fontFamily">@font/gilroy_medium_0</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="WeatherLabel">
        <item name="android:fontFamily">@font/gilroy_medium_0</item>
        <item name="android:textColor">#8A98AE</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="WeatherValue">
        <item name="android:fontFamily">@font/gilroy_medium_0</item>
        <item name="android:textColor">#4A586C</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="CardShade">
        <item name="android:background">@drawable/bg_card_shade</item>
    </style>

    <style name="CardHeart">
        <item name="android:background">@drawable/bg_heart_circle</item>
        <item name="android:padding">5dp</item>
        <item name="android:src">@drawable/ic_heart</item>
    </style>

    <style name="CardHeartFilled">
        <item name="android:background">@drawable/bg_heart_circle</item>
        <item name="android:padding">5dp</item>
        <item name="android:src">@drawable/ic_fill_favorite</item>
    </style>

    <style name="OptionRow">
        <item name="android:background">@drawable/bg_option</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="OptionText">
        <item name="android:fontFamily">@font/gropled</item>
        <item name="android:textColor">#80B4F0</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="RoundedTop28">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">28dp</item>
        <item name="cornerSizeTopRight">28dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="DayTab">
        <item name="android:fontFamily">@font/gropled</item>
        <item name="android:textColor">#3F4B5E</item>
        <item name="android:textSize">18sp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="TimelineDot">
        <item name="android:background">@drawable/bg_timeline_dot</item>
        <item name="android:fontFamily">@font/gropled</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#4A586C</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="TimelineTime">
        <item name="android:fontFamily">@font/gropled</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">#3F4B5E</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="PlaceCard">
        <item name="android:background">@drawable/bg_place_card</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="PlaceTitle">
        <item name="android:fontFamily">@font/gropled</item>
        <item name="android:textColor">#80B4F0</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="PlaceDesc">
        <item name="android:fontFamily">@font/gilroy_medium_0</item>
        <item name="android:textColor">#6B7580</item>
        <item name="android:textSize">11sp</item>
        <item name="android:layout_marginTop">4dp</item>
    </style>

    <style name="PlaceButton">
        <item name="android:background">@drawable/bg_button_yellow_soft</item>
        <item name="android:fontFamily">@font/gilroy_medium_0</item>
        <item name="android:textColor">#80B4F0</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>
</resources>