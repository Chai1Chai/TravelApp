<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RouteActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_login"
        android:importantForAccessibility="no" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="88dp"
        android:scrollbars="none"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:src="@drawable/ic_logo"
                android:importantForAccessibility="no" />

            <!-- Плашка заголовка -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_outline_white"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/buyan_bold"
                    android:text="@string/route_title"
                    android:textColor="#8FD0C0"
                    android:textSize="28sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/gilroy_medium_0"
                    android:text="@string/route_sub"
                    android:textColor="#80B4F0"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Стопка фото -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="380dp"
                android:layout_marginTop="40dp">

                <!-- Заднее фото -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="190dp"
                    android:layout_height="260dp"
                    android:layout_gravity="top|end"
                    android:layout_marginEnd="8dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/indian_sign_4"
                    app:shapeAppearanceOverlay="@style/RoundedImage24" />

                <!-- Среднее фото -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="190dp"
                    android:layout_height="260dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="40dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/thai_beach_sign_5"
                    app:shapeAppearanceOverlay="@style/RoundedImage24" />

                <!-- Переднее фото -->
                <FrameLayout
                    android:layout_width="190dp"
                    android:layout_height="230dp"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="8dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/shanhai_sign_2"
                        app:shapeAppearanceOverlay="@style/RoundedImage24" />

                    <ImageView
                        style="@style/CardHeart"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="8dp"
                        app:tint="#4FD1D9"
                        android:importantForAccessibility="no" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_glass"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/gropled"
                            android:text="@string/city_shanghai"
                            android:textColor="#F3F58A"
                            android:textSize="22sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/gropled"
                            android:text="@string/route_info"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />
                    </LinearLayout>
                </FrameLayout>
            </FrameLayout>

            <!-- Кнопка -->
            <TextView
                android:id="@+id/btnOpenRoute"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_button_yellow_soft"
                android:fontFamily="@font/gropled"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:text="@string/btn_open_route"
                android:textColor="#80B4F0"
                android:textSize="18sp" />

            <!-- Ссылка -->
            <TextView
                android:id="@+id/tvAgain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                android:fontFamily="@font/gropled"
                android:text="@string/route_again"
                android:textColor="#80B4F0"
                android:textSize="14sp" />

        </LinearLayout>
    </ScrollView>

    <include
        layout="@layout/layout_bottom_nav_plan"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>